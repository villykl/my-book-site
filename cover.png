
<div class="cover" onclick="openBook()">
  <img src="cover.jpg" style="
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
    position: absolute;
  ">

  <div style="
    position:absolute;
    bottom:20px;
    left:0;
    right:0;
    text-align:center;
    color:white;
    background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    padding:20px;
    border-radius: 0 0 18px 18px;
  ">
    <h1 style="margin:0; color:#d6b36a;">Слова — это следы души</h1>
    <p style="margin:5px 0 0; opacity:0.8;">Вера Климошенко</p>
  </div>
</div>
